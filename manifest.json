{
    "manifest_version": 3,
    "name": "Context Switching Manager",
    "version": "1.0",
    "description": "Save and restore Workspaces",
    "icons": { "48": "icons/icon.png" },
    "action": {
        "default_popup": "dist/popup/popup.html"
    },
    "permissions": ["storage", "tabs"],
    "background": {
        "service_worker": "dist/background/background.js"
    }
}